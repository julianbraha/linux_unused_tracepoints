CONFIG_UUID_KUNIT_TEST=y
CONFIG_INT_POW_KUNIT_TEST=y
CONFIG_INT_SQRT_KUNIT_TEST=y
# CONFIG_INT_LOG_KUNIT_TEST is not set
CONFIG_GCD_KUNIT_TEST=y
CONFIG_POLYNOMIAL_KUNIT_TEST=y
# CONFIG_PRIME_NUMBERS_KUNIT_TEST is not set
CONFIG_GLOB_KUNIT_TEST=y
CONFIG_PRANDOM_KUNIT_TEST=y
CONFIG_ARCH_USE_MEMTEST=y
# CONFIG_MEMTEST is not set
CONFIG_HYPERV_TESTING=y
# end of Kernel Testing and Coverage

#
# Rust hacking
#
# end of Rust hacking
# end of Kernel hacking

#
# Documentation
#
CONFIG_WARN_MISSING_DOCUMENTS=y
CONFIG_WARN_ABI_ERRORS=y
# end of Documentation

CONFIG_IO_URING_ZCRX=y
CONFIG_IO_URING_BPF=y
